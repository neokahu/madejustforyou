# Meta Ads API — secrets template. Copy to .env and fill in real values.
# .env is gitignored (root .gitignore excludes .env). NEVER commit the real file.

# From developers.facebook.com → App Settings → Basic
META_APP_ID=
META_APP_SECRET=

# Non-expiring System User token (Business Settings → System Users → Generate Token)
# Scopes: ads_read, ads_management, business_management (+ ads_mcp_management for the MCP)
META_SYSTEM_USER_TOKEN=

# From Business Settings
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=act_          # full form, e.g. act_1234567890

# Ad account settings (Business Settings → Ad Accounts → details) — the engine needs these
META_AD_ACCOUNT_CURRENCY=        # e.g. USD
META_AD_ACCOUNT_TIMEZONE=        # e.g. America/New_York

# Marketing API version (bump when Meta releases a newer one)
META_API_VERSION=v26.0
