{{ 'mc-foundation.css' | asset_url | stylesheet_tag }}
{{ 'mc-homepage.css' | asset_url | stylesheet_tag }}
{{ 'mc-category-icons.css' | asset_url | stylesheet_tag }}

<section
  class="mc-category-strip"
  style="--mc-category-bg: {{ section.settings.background }}; --mc-category-text: {{ section.settings.text_color }}; --mc-category-columns: {{ section.settings.columns }}; --mc-category-size: {{ section.settings.icon_size }}px;"
>
  <div class="mc-container">
    {% if section.settings.heading != blank %}
      <h2 class="mc-visually-hidden">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="mc-category-strip__scroller" aria-label="{{ section.settings.heading | default: 'Featured categories' | escape }}">
      {% for block in section.blocks %}
        {%- liquid
          assign icon_file = blank
          case block.settings.icon
            when 'anniversary'
              assign icon_file = 'category-anniversary.webp'
            when 'wedding'
              assign icon_file = 'category-wedding.webp'
            when 'back-to-school'
              assign icon_file = 'category-back-to-school.webp'
            when 'for-him'
              assign icon_file = 'category-for-him.webp'
            when 'for-her'
              assign icon_file = 'category-for-her.webp'
            when 'frosted-cups'
              assign icon_file = 'category-frosted-cups.webp'
          endcase
        -%}

        <a
          class="mc-category-card mc-focus-ring"
          href="{% if section.settings.use_placeholder_links %}#{% else %}{{ block.settings.link | default: '#' }}{% endif %}"
          style="--mc-category-hover-text: {{ block.settings.hover_text_color }};"
          {{ block.shopify_attributes }}
        >
          <span class="mc-category-card__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 400
                | image_tag:
                  class: 'mc-category-card__image',
                  widths: '120, 160, 200, 300, 400',
                  sizes: '(min-width: 990px) 200px, 154px',
                  loading: 'lazy',
                  alt: block.settings.label
              }}
            {% elsif icon_file != blank %}
              <img
                class="mc-category-card__image"
                src="{{ icon_file | asset_url }}"
                width="200"
                height="200"
                loading="lazy"
                alt="{{ block.settings.label | escape }}"
              >
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'mc-category-card__placeholder' }}
            {% endif %}
          </span>
          <span class="mc-category-card__label">{{ block.settings.label }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MC category strip",
  "settings": [
    { "type": "checkbox", "id": "use_placeholder_links", "label": "Use # for all links", "default": true },
    { "type": "text", "id": "heading", "label": "Accessibility heading", "default": "Featured categories" },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 3, "max": 8, "step": 1, "default": 6 },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 120, "max": 220, "step": 10, "unit": "px", "default": 180 },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#151515" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Category",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Custom icon image" },
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in icon",
          "default": "anniversary",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "anniversary", "label": "Anniversary" },
            { "value": "wedding", "label": "Wedding" },
            { "value": "back-to-school", "label": "Back To School" },
            { "value": "for-him", "label": "For Him" },
            { "value": "for-her", "label": "For Her" },
            { "value": "frosted-cups", "label": "Frosted Cups" }
          ]
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Anniversary" },
        { "type": "color", "id": "hover_text_color", "label": "Hover text color", "default": "#D7195F" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MC category strip",
      "blocks": [
        { "type": "link", "settings": { "label": "Anniversary", "icon": "anniversary" } },
        { "type": "link", "settings": { "label": "Wedding", "icon": "wedding" } },
        { "type": "link", "settings": { "label": "Back To School", "icon": "back-to-school" } },
        { "type": "link", "settings": { "label": "For Him", "icon": "for-him" } },
        { "type": "link", "settings": { "label": "For Her", "icon": "for-her" } },
        { "type": "link", "settings": { "label": "Frosted Cups", "icon": "frosted-cups" } }
      ]
    }
  ]
}
{% endschema %}