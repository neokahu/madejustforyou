{{ 'mc-foundation.css' | asset_url | stylesheet_tag }}
{{ 'mc-homepage.css' | asset_url | stylesheet_tag }}
{{ 'mc-product-showcase.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign selected_collection = section.settings.collection
  assign view_all_url = '#'
  unless section.settings.use_placeholder_links
    if section.settings.view_all_link != blank
      assign view_all_url = section.settings.view_all_link
    elsif selected_collection != blank
      assign view_all_url = selected_collection.url
    endif
  endunless

  assign button_font_weight = section.settings.button_font_weight
  if button_font_weight == blank or button_font_weight == 'theme'
    assign button_font_weight = 'var(--mc-font-accent-weight)'
  endif
-%}

<section
  class="mc-home-section mc-product-showcase"
  style="--mc-section-bg: {{ section.settings.background }}; --mc-section-text: {{ section.settings.text_color }}; --mc-showcase-badge-bg: {{ section.settings.badge_background }}; --mc-showcase-badge-text: {{ section.settings.badge_text_color }}; --mc-showcase-muted-badge-bg: {{ section.settings.sold_out_badge_background }}; --mc-showcase-price-current: {{ section.settings.current_price_color }}; --mc-showcase-price-compare: {{ section.settings.compare_at_price_color }}; --mc-showcase-button-bg: {{ section.settings.button_background }}; --mc-showcase-button-text: {{ section.settings.button_text_color }}; --mc-showcase-button-border: {{ section.settings.button_border_color }}; --mc-showcase-button-hover-bg: {{ section.settings.button_hover_background }}; --mc-showcase-button-hover-text: {{ section.settings.button_hover_text_color }}; --mc-showcase-button-radius: {{ section.settings.button_border_radius }}px; --mc-showcase-button-weight: {{ button_font_weight }};"
>
  <div class="mc-container">
    <div class="mc-section-heading">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="mc-section-heading__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<div class="mc-section-heading__text">{{ section.settings.text }}</div>{% endif %}
      </div>
    </div>

    <div class="mc-product-grid{% if section.settings.mobile_carousel %} mc-product-grid--mobile-carousel{% endif %}" style="--mc-columns: {{ section.settings.columns }};">
      {% if selected_collection != blank and selected_collection.products_count > 0 %}
        {% for product in selected_collection.products limit: section.settings.products_to_show %}
          {% render 'mc-product-card', product: product, placeholder_links: section.settings.use_placeholder_links, show_rating: section.settings.show_rating, show_badge: section.settings.show_badge, show_wishlist: section.settings.show_wishlist, image_ratio: section.settings.image_ratio, placeholder_index: forloop.index, bestseller_label: section.settings.bestseller_label, sale_label: section.settings.sale_label, sold_out_label: section.settings.sold_out_label, wishlist_label: section.settings.wishlist_label, rating_label: section.settings.rating_label %}
        {% endfor %}
      {% else %}
        {% for index in (1..12) limit: section.settings.products_to_show %}
          {% assign placeholder_image_index = index | modulo: 6 | plus: 1 %}
          {% render 'mc-product-card', placeholder_links: true, show_rating: section.settings.show_rating, show_badge: section.settings.show_badge, show_wishlist: section.settings.show_wishlist, image_ratio: section.settings.image_ratio, placeholder_index: placeholder_image_index, bestseller_label: section.settings.bestseller_label, sale_label: section.settings.sale_label, sold_out_label: section.settings.sold_out_label, wishlist_label: section.settings.wishlist_label, rating_label: section.settings.rating_label %}
        {% endfor %}
      {% endif %}
    </div>

    {% if section.settings.view_all_label != blank %}
      <div class="mc-product-showcase__footer">
        <a class="mc-product-showcase__button mc-focus-ring" href="{{ view_all_url }}">
          {{ section.settings.view_all_label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "MC product showcase",
  "settings": [
    { "type": "checkbox", "id": "use_placeholder_links", "label": "Use # for all links", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer favorites" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trending Now" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "mobile_carousel", "label": "Swipe cards on mobile", "default": false },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "square", "options": [
      { "value": "square", "label": "Square" },
      { "value": "portrait", "label": "Portrait" },
      { "value": "landscape", "label": "Landscape" }
    ] },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "checkbox", "id": "show_badge", "label": "Show badges", "default": true },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist placeholder", "default": true },
    { "type": "text", "id": "bestseller_label", "label": "Bestseller label", "default": "Bestseller" },
    { "type": "text", "id": "sale_label", "label": "Sale label", "default": "Sale" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "wishlist_label", "label": "Wishlist button label", "default": "Add to wishlist" },
    { "type": "text", "id": "rating_label", "label": "Rating accessibility suffix", "default": "out of 5 stars" },
    { "type": "header", "content": "Product card colors" },
    { "type": "color", "id": "badge_background", "label": "Badge background", "default": "#D7195F" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text color", "default": "#FFFFFF" },
    { "type": "color", "id": "sold_out_badge_background", "label": "Sold out badge background", "default": "#555555" },
    { "type": "color", "id": "current_price_color", "label": "Current price color", "default": "#D7195F" },
    { "type": "color", "id": "compare_at_price_color", "label": "Compare-at price color", "default": "#8A848A" },
    { "type": "text", "id": "view_all_label", "label": "View all button label", "default": "Shop all" },
    { "type": "url", "id": "view_all_link", "label": "Custom view all link" },
    { "type": "header", "content": "Button style" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#0D2A4A" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#FFFFFF" },
    { "type": "color", "id": "button_border_color", "label": "Button border color", "default": "#0D2A4A" },
    { "type": "color", "id": "button_hover_background", "label": "Button hover background", "default": "#FFFFFF" },
    { "type": "color", "id": "button_hover_text_color", "label": "Button hover text color", "default": "#0D2A4A" },
    { "type": "select", "id": "button_font_weight", "label": "Button font weight", "default": "theme", "options": [
      { "value": "theme", "label": "Use theme font weight" },
      { "value": "400", "label": "400 — Regular" },
      { "value": "500", "label": "500 — Medium" },
      { "value": "600", "label": "600 — Semi bold" },
      { "value": "700", "label": "700 — Bold" },
      { "value": "800", "label": "800 — Extra bold" },
      { "value": "900", "label": "900 — Black" }
    ] },
    { "type": "range", "id": "button_border_radius", "label": "Button border radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 6 },
    { "type": "header", "content": "Section colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#151515" }
  ],
  "presets": [{ "name": "MC product showcase" }]
}
{% endschema %}