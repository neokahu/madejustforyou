{{ 'mc-foundation.css' | asset_url | stylesheet_tag }}
{{ 'mc-homepage.css' | asset_url | stylesheet_tag }}
{{ 'mc-campaign-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_link = '#'
  unless section.settings.use_placeholder_links
    assign hero_link = section.settings.link | default: '#'
  endunless

  assign button_font_weight = section.settings.button_font_weight
  if button_font_weight == blank or button_font_weight == 'theme'
    assign button_font_weight = 'var(--mc-font-accent-weight)'
  endif
-%}

<section
  class="mc-campaign-hero mc-campaign-hero--{{ section.settings.content_position }}{% if section.settings.mobile_image != blank %} mc-campaign-hero--has-mobile-image{% endif %}"
  style="--mc-hero-min-height: {{ section.settings.desktop_height }}px; --mc-hero-overlay: {{ section.settings.overlay_color }}; --mc-hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --mc-hero-text: {{ section.settings.text_color }}; --mc-hero-button-bg: {{ section.settings.button_background }}; --mc-hero-button-text: {{ section.settings.button_text_color }}; --mc-hero-button-border: {{ section.settings.button_border_color }}; --mc-hero-button-hover-bg: {{ section.settings.button_hover_background }}; --mc-hero-button-hover-text: {{ section.settings.button_hover_text_color }}; --mc-hero-button-hover-border: {{ section.settings.button_hover_border_color }}; --mc-hero-button-radius: {{ section.settings.button_border_radius }}px; --mc-hero-button-min-width: {{ section.settings.button_min_width }}px; --mc-hero-button-height: {{ section.settings.button_height }}px; --mc-hero-button-padding-x: {{ section.settings.button_horizontal_padding }}px; --mc-hero-button-weight: {{ button_font_weight }};"
>
  <div class="mc-campaign-hero__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'mc-campaign-hero__image mc-campaign-hero__image--desktop',
          widths: '720, 960, 1280, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.heading
      }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'mc-campaign-hero__placeholder' }}
    {% endif %}

    {% if section.settings.mobile_image != blank %}
      {{
        section.settings.mobile_image
        | image_url: width: 1000
        | image_tag:
          class: 'mc-campaign-hero__image mc-campaign-hero__image--mobile',
          widths: '480, 720, 1000',
          sizes: '100vw',
          loading: 'eager',
          alt: section.settings.heading
      }}
    {% endif %}
    <span class="mc-campaign-hero__overlay"></span>
  </div>

  <div class="mc-container mc-campaign-hero__inner">
    <div class="mc-campaign-hero__content">
      {% if section.settings.eyebrow != blank %}<p class="mc-campaign-hero__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1 class="mc-campaign-hero__heading">{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}<div class="mc-campaign-hero__text">{{ section.settings.text }}</div>{% endif %}
      {% if section.settings.button_label != blank %}
        <a class="mc-button mc-campaign-hero__button mc-focus-ring" href="{{ hero_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MC campaign hero",
  "settings": [
    { "type": "checkbox", "id": "use_placeholder_links", "label": "Use # for button link", "default": true },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Celebrate your story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Anniversary Gifts" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Personalized keepsakes made for every chapter together.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "header", "content": "Button style" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#FFFFFF" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#171218" },
    { "type": "color", "id": "button_border_color", "label": "Button border color", "default": "#FFFFFF" },
    { "type": "color", "id": "button_hover_background", "label": "Button hover background", "default": "#24101B" },
    { "type": "color", "id": "button_hover_text_color", "label": "Button hover text color", "default": "#FFFFFF" },
    { "type": "color", "id": "button_hover_border_color", "label": "Button hover border color", "default": "#FFFFFF" },
    { "type": "select", "id": "button_font_weight", "label": "Button font weight", "default": "theme", "options": [
      { "value": "theme", "label": "Use theme font weight" },
      { "value": "400", "label": "400 — Regular" },
      { "value": "500", "label": "500 — Medium" },
      { "value": "600", "label": "600 — Semi bold" },
      { "value": "700", "label": "700 — Bold" },
      { "value": "800", "label": "800 — Extra bold" },
      { "value": "900", "label": "900 — Black" }
    ] },
    { "type": "range", "id": "button_min_width", "label": "Button minimum width", "min": 160, "max": 320, "step": 10, "unit": "px", "default": 210 },
    { "type": "range", "id": "button_height", "label": "Button height", "min": 48, "max": 72, "step": 2, "unit": "px", "default": 58 },
    { "type": "range", "id": "button_horizontal_padding", "label": "Button horizontal padding", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 42 },
    { "type": "range", "id": "button_border_radius", "label": "Button border radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 8 },
    { "type": "header", "content": "Hero layout" },
    { "type": "select", "id": "content_position", "label": "Content position", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 420, "max": 760, "step": 20, "unit": "px", "default": 580 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#24101B" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 }
  ],
  "presets": [{ "name": "MC campaign hero" }]
}
{% endschema %}