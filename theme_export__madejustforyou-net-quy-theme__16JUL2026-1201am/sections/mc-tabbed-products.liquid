{{ 'mc-foundation.css' | asset_url | stylesheet_tag }}
{{ 'mc-homepage.css' | asset_url | stylesheet_tag }}
{{ 'mc-tabbed-products.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mc-tabbed-products.js' | asset_url }}" defer></script>

{%- liquid
  assign tab_font_weight = section.settings.tab_font_weight
  if tab_font_weight == blank or tab_font_weight == 'theme'
    assign tab_font_weight = 'var(--mc-font-accent-weight)'
  endif

  assign button_font_weight = section.settings.button_font_weight
  if button_font_weight == blank or button_font_weight == 'theme'
    assign button_font_weight = 'var(--mc-font-accent-weight)'
  endif
-%}

<mc-tabbed-products
  class="mc-tabbed-products"
  data-section-id="{{ section.id }}"
  data-reveal-step="{{ section.settings.reveal_step }}"
  style="--mc-tabbed-bg: {{ section.settings.background }}; --mc-tabbed-text: {{ section.settings.text_color }}; --mc-tabbed-accent: {{ section.settings.accent_color }}; --mc-tabbed-pill-bg: {{ section.settings.inactive_tab_background }}; --mc-tabbed-tab-weight: {{ tab_font_weight }}; --mc-tabbed-button-weight: {{ button_font_weight }};"
>
  <section class="mc-tabbed-products__section">
    <div class="mc-container">
      {% if section.blocks.size > 0 %}
        <div class="mc-tabbed-products__tabs-wrap">
          <div class="mc-tabbed-products__tabs" role="tablist" aria-label="{{ section.settings.tabs_label | escape }}">
            {% for block in section.blocks %}
              <button
                class="mc-tabbed-products__tab mc-focus-ring{% if forloop.first %} is-active{% endif %}"
                id="mc-tab-{{ section.id }}-{{ block.id }}"
                type="button"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="mc-panel-{{ section.id }}-{{ block.id }}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                data-mc-tab
                data-block-id="{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label }}
              </button>
            {% endfor %}
          </div>
        </div>

        <div class="mc-tabbed-products__panels">
          {% for block in section.blocks %}
            <div
              class="mc-tabbed-products__panel"
              id="mc-panel-{{ section.id }}-{{ block.id }}"
              role="tabpanel"
              aria-labelledby="mc-tab-{{ section.id }}-{{ block.id }}"
              {% unless forloop.first %}hidden{% endunless %}
              data-mc-panel
              data-block-id="{{ block.id }}"
            >
              <div data-mc-panel-mount>
                {% if forloop.first %}
                  {% render 'mc-tabbed-product-panel', tab_collection: block.settings.collection, products_per_tab: section.settings.products_per_tab, initial_products: section.settings.initial_products, columns: section.settings.columns, mobile_carousel: section.settings.mobile_carousel, placeholder_links: false, show_rating: section.settings.show_rating, show_badge: section.settings.show_badge, show_wishlist: section.settings.show_wishlist, image_ratio: section.settings.image_ratio, show_more_label: section.settings.show_more_label, bestseller_label: section.settings.bestseller_label, sale_label: section.settings.sale_label, sold_out_label: section.settings.sold_out_label, wishlist_label: section.settings.wishlist_label, rating_label: section.settings.rating_label %}
                {% endif %}
              </div>

              {% unless forloop.first %}
                <template data-mc-panel-template>
                  {% render 'mc-tabbed-product-panel', tab_collection: block.settings.collection, products_per_tab: section.settings.products_per_tab, initial_products: section.settings.initial_products, columns: section.settings.columns, mobile_carousel: section.settings.mobile_carousel, placeholder_links: false, show_rating: section.settings.show_rating, show_badge: section.settings.show_badge, show_wishlist: section.settings.show_wishlist, image_ratio: section.settings.image_ratio, show_more_label: section.settings.show_more_label, bestseller_label: section.settings.bestseller_label, sale_label: section.settings.sale_label, sold_out_label: section.settings.sold_out_label, wishlist_label: section.settings.wishlist_label, rating_label: section.settings.rating_label %}
                </template>
              {% endunless %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
</mc-tabbed-products>

{% schema %}
{
  "name": "MC campaign product tabs",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "tabs_label", "label": "Tabs accessibility label", "default": "Product categories" },
    { "type": "range", "id": "products_per_tab", "label": "Products loaded per tab", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "initial_products", "label": "Products shown initially", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "reveal_step", "label": "Products revealed per click", "min": 1, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "mobile_carousel", "label": "Swipe products on mobile", "default": true },
    { "type": "select", "id": "image_ratio", "label": "Product image ratio", "default": "square", "options": [
      { "value": "square", "label": "Square" },
      { "value": "portrait", "label": "Portrait" },
      { "value": "landscape", "label": "Landscape" }
    ] },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": false },
    { "type": "checkbox", "id": "show_badge", "label": "Show badges", "default": false },
    { "type": "checkbox", "id": "show_wishlist", "label": "Show wishlist", "default": false },
    { "type": "text", "id": "show_more_label", "label": "Show more label", "default": "Show More" },
    { "type": "header", "content": "Typography" },
    { "type": "select", "id": "tab_font_weight", "label": "Tab font weight", "default": "theme", "options": [
      { "value": "theme", "label": "Use theme font weight" },
      { "value": "400", "label": "400 — Regular" },
      { "value": "500", "label": "500 — Medium" },
      { "value": "600", "label": "600 — Semi bold" },
      { "value": "700", "label": "700 — Bold" },
      { "value": "800", "label": "800 — Extra bold" },
      { "value": "900", "label": "900 — Black" }
    ] },
    { "type": "select", "id": "button_font_weight", "label": "Show More font weight", "default": "theme", "options": [
      { "value": "theme", "label": "Use theme font weight" },
      { "value": "400", "label": "400 — Regular" },
      { "value": "500", "label": "500 — Medium" },
      { "value": "600", "label": "600 — Semi bold" },
      { "value": "700", "label": "700 — Bold" },
      { "value": "800", "label": "800 — Extra bold" },
      { "value": "900", "label": "900 — Black" }
    ] },
    { "type": "text", "id": "bestseller_label", "label": "Bestseller label", "default": "Bestseller" },
    { "type": "text", "id": "sale_label", "label": "Sale label", "default": "Sale" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "wishlist_label", "label": "Wishlist label", "default": "Add to wishlist" },
    { "type": "text", "id": "rating_label", "label": "Rating accessibility suffix", "default": "out of 5 stars" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0D2A4A" },
    { "type": "color", "id": "accent_color", "label": "Active tab and price color", "default": "#FF7A00" },
    { "type": "color", "id": "inactive_tab_background", "label": "Inactive tab background", "default": "#F3F3F3" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Product tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Best sellers" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MC campaign product tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "Best sellers" } },
        { "type": "tab", "settings": { "label": "New arrivals" } },
        { "type": "tab", "settings": { "label": "Gifts" } }
      ]
    }
  ]
}
{% endschema %}