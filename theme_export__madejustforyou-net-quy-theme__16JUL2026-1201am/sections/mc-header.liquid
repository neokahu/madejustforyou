{{ 'mc-foundation.css' | asset_url | stylesheet_tag }}
{{ 'mc-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mc-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign selected_menu = section.settings.menu
  assign placeholder_links = section.settings.use_placeholder_links
  assign logo_width = section.settings.logo_width
  assign logo_width_2x = logo_width | times: 2
  assign localization_form_id = 'McHeaderLocalization-' | append: section.id
  assign mobile_localization_form_id = 'McMobileLocalization-' | append: section.id
  assign search_suggest_url = routes.predictive_search_url | append: '.json'
-%}

<header
  class="mc-header header-section"
  data-mc-header
  data-sticky="{{ section.settings.enable_sticky }}"
  data-placeholder-links="{{ placeholder_links }}"
  data-currency-code="{{ localization.country.currency.iso_code | escape }}"
  data-locale="{{ request.locale.iso_code | escape }}"
  data-searching-text="{{ section.settings.searching_text | escape }}"
  data-empty-text="{{ section.settings.no_results_text | escape }}"
  data-error-text="{{ section.settings.search_error_text | escape }}"
  style="
    --mc-header-bg: {{ section.settings.header_background }};
    --mc-header-text: {{ section.settings.header_text }};
    --mc-header-accent: {{ section.settings.accent_color }};
    --mc-announcement-bg: {{ section.settings.announcement_background }};
    --mc-announcement-text: {{ section.settings.announcement_text_color }};
  "
>
  {% if section.settings.show_announcement %}
    <div class="mc-header__announcement">
      <div class="mc-container mc-header__announcement-inner">
        <a class="mc-header__announcement-left mc-focus-ring" href="{% if placeholder_links %}#{% else %}{{ section.settings.announcement_left_link | default: '#' }}{% endif %}">
          {{ section.settings.announcement_left }}
        </a>
        <a class="mc-header__announcement-center mc-focus-ring" href="{% if placeholder_links %}#{% else %}{{ section.settings.announcement_center_link | default: '#' }}{% endif %}">
          {{ section.settings.announcement_center }}
        </a>
        <a class="mc-header__announcement-right mc-focus-ring" href="{% if placeholder_links %}#{% else %}{{ section.settings.announcement_right_link | default: '#' }}{% endif %}">
          {{ section.settings.announcement_right }}
        </a>
      </div>
    </div>
  {% endif %}

  <div class="mc-header__main">
    <div class="mc-container mc-header__main-row">
      <button
        class="mc-reset-button mc-header__menu-toggle mc-focus-ring"
        type="button"
        aria-label="{{ section.settings.menu_label | escape }}"
        aria-expanded="false"
        aria-controls="McMenuDrawer-{{ section.id }}"
        data-mc-open="menu"
      >
        <svg class="mc-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>

      <a class="mc-header__brand mc-focus-ring" href="{% if placeholder_links %}#{% else %}{{ routes.root_url }}{% endif %}">
        {% if settings.logo != blank %}
          {{
            settings.logo
            | image_url: width: logo_width_2x
            | image_tag:
              class: 'mc-header__logo',
              widths: '120, 180, 240, 320, 400',
              width: logo_width,
              alt: shop.name
          }}
        {% else %}
          <span class="mc-header__brand-text">{{ shop.name }}</span>
        {% endif %}
      </a>

      <div class="mc-header__desktop-search">
        <button
          class="mc-reset-button mc-header__search-trigger mc-focus-ring"
          type="button"
          data-mc-open="search"
          aria-expanded="false"
          aria-controls="McSearchDrawer-{{ section.id }}"
          aria-label="{{ section.settings.search_label | escape }}"
        >
          <svg class="mc-icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/>
            <path d="m20 20-3.8-3.8"/>
          </svg>
          <span>{{ section.settings.search_placeholder }}</span>
        </button>
      </div>

      <div class="mc-header__utilities">
        <button
          class="mc-reset-button mc-header__utility mc-focus-ring"
          type="button"
          data-mc-open="search"
          aria-expanded="false"
          aria-controls="McSearchDrawer-{{ section.id }}"
          aria-label="{{ section.settings.search_label | escape }}"
        >
          <svg class="mc-icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/>
            <path d="m20 20-3.8-3.8"/>
          </svg>
        </button>

        {% if section.settings.show_account %}
          <a
            class="mc-header__utility mc-header__utility--account mc-focus-ring"
            href="{% if placeholder_links %}#{% else %}{{ routes.account_url }}{% endif %}"
            aria-label="{{ section.settings.account_label | escape }}"
          >
            <svg class="mc-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="8" r="4"/>
              <path d="M4.5 21a7.5 7.5 0 0 1 15 0"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.show_tracking %}
          <a
            class="mc-header__utility mc-header__utility--desktop mc-focus-ring"
            href="{% if placeholder_links %}#{% else %}{{ section.settings.tracking_url | default: '#' }}{% endif %}"
            aria-label="{{ section.settings.track_order_label | escape }}"
          >
            <svg class="mc-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/>
              <circle cx="7" cy="18" r="2"/>
              <circle cx="18" cy="18" r="2"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.show_wishlist %}
          <a
            class="mc-header__utility mc-header__utility--desktop mc-focus-ring"
            href="{% if placeholder_links %}#{% else %}{{ section.settings.wishlist_url | default: '#' }}{% endif %}"
            aria-label="{{ section.settings.wishlist_label | escape }}"
          >
            <svg class="mc-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.show_localization %}
          {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
            <details class="mc-header__localization">
              <summary class="mc-header__utility mc-focus-ring" aria-label="{{ section.settings.country_language_label | escape }}">
                <svg class="mc-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"/>
                  <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/>
                </svg>
              </summary>
              <div class="mc-header__localization-panel">
                {% form 'localization', id: localization_form_id %}
                  <div class="mc-header__localization-grid">
                    {% if localization.available_countries.size > 1 %}
                      <label class="mc-header__field">
                        <span>{{ section.settings.country_label }}</span>
                        <select name="country_code" onchange="this.form.submit()">
                          {% for country in localization.available_countries %}
                            <option
                              value="{{ country.iso_code }}"
                              {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
                            >
                              {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                            </option>
                          {% endfor %}
                        </select>
                      </label>
                    {% endif %}
                    {% if localization.available_languages.size > 1 %}
                      <label class="mc-header__field">
                        <span>{{ section.settings.language_label }}</span>
                        <select name="locale_code" onchange="this.form.submit()">
                          {% for language in localization.available_languages %}
                            <option
                              value="{{ language.iso_code }}"
                              {% if language.iso_code == localization.language.iso_code %}selected{% endif %}
                            >
                              {{ language.endonym_name | capitalize }}
                            </option>
                          {% endfor %}
                        </select>
                      </label>
                    {% endif %}
                  </div>
                {% endform %}
              </div>
            </details>
          {% endif %}
        {% endif %}

        <a
          class="mc-header__utility mc-header__cart mc-focus-ring"
          href="{% if placeholder_links %}#{% else %}{{ routes.cart_url }}{% endif %}"
          aria-label="{{ section.settings.cart_label | escape }}"
        >
          <svg class="mc-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 8H6"/>
            <circle cx="10" cy="20" r="1"/>
            <circle cx="18" cy="20" r="1"/>
          </svg>
          {% if cart.item_count > 0 %}
            <span class="mc-header__cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </div>
    </div>
  </div>

  <nav class="mc-nav" aria-label="{{ section.settings.menu_label | escape }}">
    <div class="mc-container">
      <ul class="mc-nav__list">
        {% if selected_menu != blank %}
          {% for link in selected_menu.links %}
            <li class="mc-nav__item">
              {% if link.links != blank %}
                {%- liquid
                  assign promo_block = nil
                  for block in section.blocks
                    if block.settings.menu_title == link.title
                      assign promo_block = block
                      break
                    endif
                  endfor
                -%}
                <details class="mc-nav__details" data-mc-mega>
                  <summary class="mc-nav__summary mc-focus-ring">{{ link.title }}</summary>
                  <div class="mc-mega">
                    <div class="mc-container mc-mega__grid{% if promo_block != nil %} mc-mega__grid--with-promo{% endif %}">
                      <div class="mc-mega__columns">
                        {% for child_link in link.links limit: 5 %}
                          <div>
                            <a
                              class="mc-mega__column-title mc-focus-ring"
                              href="{% if placeholder_links %}#{% else %}{{ child_link.url }}{% endif %}"
                            >
                              {{ child_link.title }}
                            </a>
                            {% if child_link.links != blank %}
                              <ul class="mc-mega__links">
                                {% for grandchild_link in child_link.links limit: 8 %}
                                  <li>
                                    <a href="{% if placeholder_links %}#{% else %}{{ grandchild_link.url }}{% endif %}">
                                      {{ grandchild_link.title }}
                                    </a>
                                  </li>
                                {% endfor %}
                              </ul>
                            {% endif %}
                          </div>
                        {% endfor %}
                      </div>

                      {% if promo_block != nil %}
                        <a
                          class="mc-mega__promo mc-focus-ring"
                          href="{% if placeholder_links %}#{% else %}{{ promo_block.settings.link | default: '#' }}{% endif %}"
                          style="--mc-promo-bg: {{ promo_block.settings.background_color }};"
                          {{ promo_block.shopify_attributes }}
                        >
                          {% if promo_block.settings.image != blank %}
                            {{
                              promo_block.settings.image
                              | image_url: width: 720
                              | image_tag:
                                class: 'mc-mega__promo-image',
                                widths: '280, 420, 560, 720',
                                loading: 'lazy',
                                alt: promo_block.settings.heading
                            }}
                          {% endif %}
                          <span class="mc-mega__promo-overlay"></span>
                          <span class="mc-mega__promo-copy">
                            {% if promo_block.settings.eyebrow != blank %}
                              <span class="mc-mega__promo-eyebrow">{{ promo_block.settings.eyebrow }}</span>
                            {% endif %}
                            <strong>{{ promo_block.settings.heading }}</strong>
                            {% if promo_block.settings.text != blank %}
                              <span>{{ promo_block.settings.text }}</span>
                            {% endif %}
                            {% if promo_block.settings.link_label != blank %}
                              <span class="mc-mega__promo-link">{{ promo_block.settings.link_label }}</span>
                            {% endif %}
                          </span>
                        </a>
                      {% endif %}
                    </div>
                  </div>
                </details>
              {% else %}
                <a
                  class="mc-nav__plain-link mc-focus-ring"
                  href="{% if placeholder_links %}#{% else %}{{ link.url }}{% endif %}"
                >
                  {{ link.title }}
                </a>
              {% endif %}
            </li>
          {% endfor %}
        {% else %}
          {% assign fallback_menu = 'Occasion,Recipient,Interest,Product,Price' | split: ',' %}
          {% for item in fallback_menu %}
            <li class="mc-nav__item">
              <a class="mc-nav__plain-link mc-focus-ring" href="#">{{ item }}</a>
            </li>
          {% endfor %}
        {% endif %}
      </ul>
    </div>
  </nav>

  <div
    id="McMenuDrawer-{{ section.id }}"
    class="mc-drawer mc-drawer--left"
    data-mc-drawer="menu"
    data-open="false"
    aria-hidden="true"
  >
    <button class="mc-reset-button mc-drawer__backdrop" type="button" data-mc-backdrop aria-label="{{ section.settings.close_menu_label | escape }}"></button>
    <div class="mc-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="McMenuTitle-{{ section.id }}" tabindex="-1">
      <div class="mc-drawer__header">
        <h2 id="McMenuTitle-{{ section.id }}" class="mc-drawer__title">{{ section.settings.menu_label }}</h2>
        <button class="mc-reset-button mc-drawer__close mc-focus-ring" type="button" data-mc-close aria-label="{{ section.settings.close_menu_label | escape }}">
          <svg class="mc-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
        </button>
      </div>
      <div class="mc-drawer__body">
        <nav class="mc-mobile-nav" aria-label="{{ section.settings.menu_label | escape }}" data-mc-mobile-nav>
          <div class="mc-mobile-nav__panel is-active" data-mc-mobile-panel="root">
            {% if selected_menu != blank %}
              {% for link in selected_menu.links %}
                {% if link.links != blank %}
                  <button
                    class="mc-reset-button mc-mobile-nav__row mc-mobile-nav__row--next"
                    type="button"
                    data-mc-mobile-open="level-1-{{ forloop.index }}"
                  >
                    <span>{{ link.title }}</span>
                    <span aria-hidden="true">›</span>
                  </button>
                {% else %}
                  <a class="mc-mobile-nav__row" href="{% if placeholder_links %}#{% else %}{{ link.url }}{% endif %}">{{ link.title }}</a>
                {% endif %}
              {% endfor %}
            {% else %}
              {% assign fallback_menu = 'Occasion,Recipient,Interest,Product,Price' | split: ',' %}
              {% for item in fallback_menu %}
                <a class="mc-mobile-nav__row" href="#">{{ item }}</a>
              {% endfor %}
            {% endif %}

            <div class="mc-mobile-nav__meta">
              {% if section.settings.show_account %}
                <a href="{% if placeholder_links %}#{% else %}{{ routes.account_url }}{% endif %}">{{ section.settings.account_label }}</a>
              {% endif %}
              {% if section.settings.show_tracking %}
                <a href="{% if placeholder_links %}#{% else %}{{ section.settings.tracking_url | default: '#' }}{% endif %}">{{ section.settings.track_order_label }}</a>
              {% endif %}
              {% if section.settings.show_wishlist %}
                <a href="{% if placeholder_links %}#{% else %}{{ section.settings.wishlist_url | default: '#' }}{% endif %}">{{ section.settings.wishlist_label }}</a>
              {% endif %}
              <a href="{% if placeholder_links %}#{% else %}{{ section.settings.help_center_url | default: '#' }}{% endif %}">{{ section.settings.help_center_label }}</a>
            </div>

            {% if section.settings.show_localization %}
              {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
                <div class="mc-mobile-nav__localization">
                  {% form 'localization', id: mobile_localization_form_id %}
                    {% if localization.available_countries.size > 1 %}
                      <label class="mc-header__field">
                        <span>{{ section.settings.country_label }}</span>
                        <select name="country_code" onchange="this.form.submit()">
                          {% for country in localization.available_countries %}
                            <option
                              value="{{ country.iso_code }}"
                              {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
                            >
                              {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                            </option>
                          {% endfor %}
                        </select>
                      </label>
                    {% endif %}
                    {% if localization.available_languages.size > 1 %}
                      <label class="mc-header__field">
                        <span>{{ section.settings.language_label }}</span>
                        <select name="locale_code" onchange="this.form.submit()">
                          {% for language in localization.available_languages %}
                            <option
                              value="{{ language.iso_code }}"
                              {% if language.iso_code == localization.language.iso_code %}selected{% endif %}
                            >
                              {{ language.endonym_name | capitalize }}
                            </option>
                          {% endfor %}
                        </select>
                      </label>
                    {% endif %}
                  {% endform %}
                </div>
              {% endif %}
            {% endif %}
          </div>

          {% if selected_menu != blank %}
            {% for link in selected_menu.links %}
              {% if link.links != blank %}
                {% assign level_1_index = forloop.index %}
                <div class="mc-mobile-nav__panel" data-mc-mobile-panel="level-1-{{ level_1_index }}" hidden>
                  <button class="mc-reset-button mc-mobile-nav__back" type="button" data-mc-mobile-back="root">
                    <span aria-hidden="true">‹</span>
                    <span>{{ section.settings.back_label }}</span>
                  </button>
                  <h3 class="mc-mobile-nav__panel-title">{{ link.title }}</h3>
                  <a class="mc-mobile-nav__shop-all" href="{% if placeholder_links %}#{% else %}{{ link.url }}{% endif %}">
                    {{ section.settings.shop_all_label }} {{ link.title }}
                  </a>
                  {% for child_link in link.links %}
                    {% if child_link.links != blank %}
                      <button
                        class="mc-reset-button mc-mobile-nav__row mc-mobile-nav__row--next"
                        type="button"
                        data-mc-mobile-open="level-2-{{ level_1_index }}-{{ forloop.index }}"
                      >
                        <span>{{ child_link.title }}</span>
                        <span aria-hidden="true">›</span>
                      </button>
                    {% else %}
                      <a class="mc-mobile-nav__row" href="{% if placeholder_links %}#{% else %}{{ child_link.url }}{% endif %}">
                        {{ child_link.title }}
                      </a>
                    {% endif %}
                  {% endfor %}
                </div>

                {% for child_link in link.links %}
                  {% if child_link.links != blank %}
                    <div class="mc-mobile-nav__panel" data-mc-mobile-panel="level-2-{{ level_1_index }}-{{ forloop.index }}" hidden>
                      <button class="mc-reset-button mc-mobile-nav__back" type="button" data-mc-mobile-back="level-1-{{ level_1_index }}">
                        <span aria-hidden="true">‹</span>
                        <span>{{ link.title }}</span>
                      </button>
                      <h3 class="mc-mobile-nav__panel-title">{{ child_link.title }}</h3>
                      <a class="mc-mobile-nav__shop-all" href="{% if placeholder_links %}#{% else %}{{ child_link.url }}{% endif %}">
                        {{ section.settings.shop_all_label }} {{ child_link.title }}
                      </a>
                      {% for grandchild_link in child_link.links %}
                        <a class="mc-mobile-nav__row" href="{% if placeholder_links %}#{% else %}{{ grandchild_link.url }}{% endif %}">
                          {{ grandchild_link.title }}
                        </a>
                      {% endfor %}
                    </div>
                  {% endif %}
                {% endfor %}
              {% endif %}
            {% endfor %}
          {% endif %}
        </nav>
      </div>
    </div>
  </div>

  <div
    id="McSearchDrawer-{{ section.id }}"
    class="mc-drawer mc-drawer--right"
    data-mc-drawer="search"
    data-open="false"
    data-suggest-url="{{ search_suggest_url }}"
    aria-hidden="true"
  >
    <button class="mc-reset-button mc-drawer__backdrop" type="button" data-mc-backdrop aria-label="{{ section.settings.close_search_label | escape }}"></button>
    <div class="mc-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="McSearchTitle-{{ section.id }}" tabindex="-1">
      <div class="mc-drawer__header">
        <h2 id="McSearchTitle-{{ section.id }}" class="mc-drawer__title">{{ section.settings.search_label }}</h2>
        <button class="mc-reset-button mc-drawer__close mc-focus-ring" type="button" data-mc-close aria-label="{{ section.settings.close_search_label | escape }}">
          <svg class="mc-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
        </button>
      </div>
      <div class="mc-drawer__body">
        <form
          class="mc-search__form"
          action="{% if placeholder_links %}#{% else %}{{ routes.search_url }}{% endif %}"
          method="get"
          role="search"
          data-mc-search-form
        >
          <label class="mc-visually-hidden" for="McSearchInput-{{ section.id }}">{{ section.settings.search_products_label }}</label>
          <input
            id="McSearchInput-{{ section.id }}"
            class="mc-search__input"
            type="search"
            name="q"
            placeholder="{{ section.settings.search_placeholder }}"
            autocomplete="off"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="McSearchResults-{{ section.id }}"
            data-mc-search-input
            data-mc-autofocus
          >
          <button class="mc-reset-button mc-search__submit mc-focus-ring" type="submit" aria-label="{{ section.settings.submit_search_label | escape }}">
            <svg class="mc-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/>
              <path d="m20 20-3.8-3.8"/>
            </svg>
          </button>
        </form>

        <p class="mc-search__label">{{ section.settings.trending_searches_label }}</p>
        <div class="mc-search__trends">
          {% assign trends = section.settings.trending_searches | split: ',' %}
          {% for trend in trends %}
            {% assign clean_trend = trend | strip %}
            {% if clean_trend != blank %}
              <a
                class="mc-search__trend"
                href="{% if placeholder_links %}#{% else %}{{ routes.search_url }}?q={{ clean_trend | url_encode }}{% endif %}"
              >
                {{ clean_trend }}
              </a>
            {% endif %}
          {% endfor %}
        </div>

        <p class="mc-search__label">{{ section.settings.suggestions_label }}</p>
        <div
          id="McSearchResults-{{ section.id }}"
          class="mc-search__results"
          data-mc-search-results
          role="listbox"
          aria-label="{{ section.settings.suggestions_label | escape }}"
          aria-live="polite"
        ></div>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "MC header",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_placeholder_links",
      "label": "Use # for all navigation links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_left",
      "label": "Announcement left",
      "default": "30-day money-back guarantee"
    },
    {
      "type": "text",
      "id": "announcement_left_link",
      "label": "Announcement left link",
      "default": "#"
    },
    {
      "type": "text",
      "id": "announcement_center",
      "label": "Announcement center",
      "default": "Free shipping on orders over $79"
    },
    {
      "type": "text",
      "id": "announcement_center_link",
      "label": "Announcement center link",
      "default": "#"
    },
    {
      "type": "text",
      "id": "announcement_right",
      "label": "Announcement right",
      "default": "24/7 customer support"
    },
    {
      "type": "text",
