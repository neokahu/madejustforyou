{{ 'mc-foundation.css' | asset_url | stylesheet_tag }}
{{ 'mc-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign placeholder_links = section.settings.use_placeholder_links
  assign logo_width = section.settings.logo_width
  assign logo_width_2x = logo_width | times: 2
  assign localization_form_id = 'McFooterLocalization-' | append: section.id
-%}

<div
  class="mc-footer"
  style="
    --mc-footer-bg: {{ section.settings.background }};
    --mc-footer-text: {{ section.settings.text_color }};
    --mc-footer-muted: {{ section.settings.muted_color }};
    --mc-footer-accent: {{ section.settings.accent_color }};
  "
>
  {% if section.settings.show_newsletter %}
    <div class="mc-footer__newsletter">
      <div class="mc-container mc-footer__newsletter-grid">
        <div>
          <p class="mc-footer__eyebrow">{{ section.settings.newsletter_eyebrow }}</p>
          <h2 class="mc-footer__newsletter-title">{{ section.settings.newsletter_heading }}</h2>
          <p class="mc-footer__newsletter-copy">{{ section.settings.newsletter_text }}</p>
        </div>
        <div>
          {% form 'customer', class: 'mc-footer__newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="mc-footer__form">
              <label class="mc-visually-hidden" for="McFooterEmail-{{ section.id }}">{{ section.settings.email_label }}</label>
              <input
                id="McFooterEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ section.settings.newsletter_placeholder }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                required
              >
              <button type="submit">{{ section.settings.newsletter_button }}</button>
            </div>
            {% if form.posted_successfully? %}
              <p class="mc-footer__form-message" role="status">{{ section.settings.newsletter_success }}</p>
            {% endif %}
            {% if form.errors %}
              <div class="mc-footer__form-message" role="alert">{{ form.errors | default_errors }}</div>
            {% endif %}
          {% endform %}
        </div>
      </div>
    </div>
  {% endif %}

  <div class="mc-footer__main">
    <div class="mc-container mc-footer__grid">
      <div class="mc-footer__brand-column">
        <a class="mc-footer__brand mc-focus-ring" href="{% if placeholder_links %}#{% else %}{{ routes.root_url }}{% endif %}">
          {% if settings.logo_inverse != blank %}
            {{
              settings.logo_inverse
              | image_url: width: logo_width_2x
              | image_tag:
                class: 'mc-footer__logo',
                widths: '120, 180, 240, 320, 400',
                width: logo_width,
                alt: shop.name
            }}
          {% elsif settings.logo != blank %}
            {{
              settings.logo
              | image_url: width: logo_width_2x
              | image_tag:
                class: 'mc-footer__logo',
                widths: '120, 180, 240, 320, 400',
                width: logo_width,
                alt: shop.name
            }}
          {% else %}
            <span class="mc-footer__brand-text">{{ shop.name }}</span>
          {% endif %}
        </a>
        <div class="mc-footer__about">{{ section.settings.about_text }}</div>
        <div class="mc-footer__support">
          <strong>{{ section.settings.support_heading }}</strong><br>
          {{ section.settings.support_text }}
        </div>

        <div class="mc-footer__social" aria-label="{{ section.settings.social_label | escape }}">
          <a href="{% if placeholder_links %}#{% else %}{{ section.settings.facebook_url | default: '#' }}{% endif %}" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v8h4v-8h3.2l.8-4H13V9c0-.7.3-1 1-1Z"/></svg>
          </a>
          <a href="{% if placeholder_links %}#{% else %}{{ section.settings.instagram_url | default: '#' }}{% endif %}" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          </a>
          <a href="{% if placeholder_links %}#{% else %}{{ section.settings.tiktok_url | default: '#' }}{% endif %}" aria-label="TikTok">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v11.2a4.2 4.2 0 1 1-3.6-4.2"/><path d="M14 3c.8 3 2.5 4.6 5 5"/></svg>
          </a>
          <a href="{% if placeholder_links %}#{% else %}{{ section.settings.pinterest_url | default: '#' }}{% endif %}" aria-label="Pinterest">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 20.5c1-3 1.7-5.1 2.1-6.4-.8-1.5-.2-4.7 1.4-4.7 1.3 0 1.8 1.3 1.8 2.4 0 1.5-1 3.7-2.2 3.7-1 0-1.4-.8-1.2-1.8"/><path d="M8.5 21a9 9 0 1 1 7.2-.2"/></svg>
          </a>
        </div>
      </div>

      {% for index in (1..4) %}
        {% case index %}
          {% when 1 %}
            {% assign menu = section.settings.menu_1 %}
            {% assign heading = section.settings.menu_1_heading %}
            {% assign fallback = 'Home & Living,Drinkware,Apparel,Accessories,Best Sellers' | split: ',' %}
          {% when 2 %}
            {% assign menu = section.settings.menu_2 %}
            {% assign heading = section.settings.menu_2_heading %}
            {% assign fallback = 'Anniversary,Wedding,Birthday,Christmas,Memorial' | split: ',' %}
          {% when 3 %}
            {% assign menu = section.settings.menu_3 %}
            {% assign heading = section.settings.menu_3_heading %}
            {% assign fallback = 'For Her,For Him,For Couples,For Mom,For Dad' | split: ',' %}
          {% when 4 %}
            {% assign menu = section.settings.menu_4 %}
            {% assign heading = section.settings.menu_4_heading %}
            {% assign fallback = 'Contact Us,Track Order,Shipping,Returns,FAQs' | split: ',' %}
        {% endcase %}

        <div>
          <h3 class="mc-footer__heading">{{ heading }}</h3>
          <ul class="mc-footer__links">
            {% if menu != blank %}
              {% for link in menu.links %}
                <li><a href="{% if placeholder_links %}#{% else %}{{ link.url }}{% endif %}">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              {% for item in fallback %}
                <li><a href="#">{{ item }}</a></li>
              {% endfor %}
            {% endif %}
          </ul>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="mc-footer__lower">
    <div class="mc-container">
      <div class="mc-footer__lower-grid">
        {% if section.settings.show_localization %}
          <div class="mc-footer__selectors">
            {% form 'localization', id: localization_form_id %}
              {% if localization.available_countries.size > 1 %}
                <label>
                  <span class="mc-visually-hidden">{{ section.settings.country_label }}</span>
                  <select name="country_code" onchange="this.form.submit()" aria-label="{{ section.settings.country_label | escape }}">
                    {% for country in localization.available_countries %}
                      <option
                        value="{{ country.iso_code }}"
                        {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
                      >
                        {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                      </option>
                    {% endfor %}
                  </select>
                </label>
              {% endif %}
              {% if localization.available_languages.size > 1 %}
                <label>
                  <span class="mc-visually-hidden">{{ section.settings.language_label }}</span>
                  <select name="locale_code" onchange="this.form.submit()" aria-label="{{ section.settings.language_label | escape }}">
                    {% for language in localization.available_languages %}
                      <option
                        value="{{ language.iso_code }}"
                        {% if language.iso_code == localization.language.iso_code %}selected{% endif %}
                      >
                        {{ language.endonym_name | capitalize }}
                      </option>
                    {% endfor %}
                  </select>
                </label>
              {% endif %}
            {% endform %}
          </div>
        {% endif %}

        {% if section.settings.show_payment_icons %}
          <div class="mc-footer__payments" aria-label="{{ section.settings.payment_methods_label | escape }}">
            {% for type in shop.enabled_payment_types %}
              {{ type | payment_type_svg_tag }}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="mc-footer__legal">
        <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.rights_label }}</span>
        <div class="mc-footer__policy-links">
          {% if placeholder_links %}
            <a href="#">{{ section.settings.privacy_label }}</a>
            <a href="#">{{ section.settings.terms_label }}</a>
            <a href="#">{{ section.settings.shipping_label }}</a>
            <a href="#">{{ section.settings.refund_label }}</a>
          {% else %}
            {% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}">{{ section.settings.privacy_label }}</a>{% endif %}
            {% if shop.terms_of_service != blank %}<a href="{{ shop.terms_of_service.url }}">{{ section.settings.terms_label }}</a>{% endif %}
            {% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">{{ section.settings.shipping_label }}</a>{% endif %}
            {% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">{{ section.settings.refund_label }}</a>{% endif %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
