{{ 'mc-foundation.css' | asset_url | stylesheet_tag }}
{{ 'mc-homepage.css' | asset_url | stylesheet_tag }}
{{ 'mc-image-link-grid.css' | asset_url | stylesheet_tag }}

<section
  class="mc-home-section mc-image-link-section"
  style="--mc-section-bg: {{ section.settings.background }}; --mc-section-text: {{ section.settings.text_color }}; --mc-mobile-card-width: {{ section.settings.mobile_card_width }}vw;"
>
  <div class="mc-container">
    <div class="mc-section-heading mc-section-heading--center">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="mc-section-heading__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<div class="mc-section-heading__text">{{ section.settings.text }}</div>{% endif %}
      </div>
    </div>

    <div class="mc-image-link-grid{% if section.settings.mobile_carousel %} mc-image-link-grid--mobile-carousel{% endif %}" style="--mc-grid-columns: {{ section.settings.columns }};">
      {% for block in section.blocks %}
        <a
          class="mc-image-link-card mc-image-link-card--{{ section.settings.card_style }} mc-focus-ring"
          href="{% if section.settings.use_placeholder_links %}#{% else %}{{ block.settings.link | default: '#' }}{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="mc-image-link-card__media mc-image-link-card__media--{{ section.settings.image_ratio }}">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 900 | image_tag: class: 'mc-image-link-card__image', widths: '240, 360, 480, 640, 900', sizes: '(min-width: 990px) 20vw, 72vw', loading: 'lazy', alt: block.settings.title }}
            {% elsif block.settings.builtin_image != blank and block.settings.builtin_image != 'none' %}
              <span class="mc-image-link-card__builtin-frame" aria-hidden="true">
                <img
                  class="mc-image-link-card__builtin mc-image-link-card__builtin--{{ block.settings.builtin_image }}"
                  src="{{ 'recipient-category-sprite.webp' | asset_url }}"
                  width="1600"
                  height="800"
                  loading="lazy"
                  alt=""
                >
              </span>
            {% else %}
              {% assign placeholder_number = forloop.index | modulo: 6 | plus: 1 %}
              {{ 'collection-' | append: placeholder_number | placeholder_svg_tag: 'mc-image-link-card__placeholder' }}
            {% endif %}
          </div>
          <div class="mc-image-link-card__copy">
            <h3>{{ block.settings.title }}</h3>
            {% if block.settings.subtitle != blank %}<p>{{ block.settings.subtitle }}</p>{% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MC image link grid",
  "settings": [
    { "type": "checkbox", "id": "use_placeholder_links", "label": "Use # for all links", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop By Recipient" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 3, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "mobile_carousel", "label": "Swipe cards on mobile", "default": true },
    { "type": "range", "id": "mobile_card_width", "label": "Mobile card width", "min": 50, "max": 85, "step": 5, "unit": "%", "default": 70 },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "square", "options": [
      { "value": "square", "label": "Square" },
      { "value": "portrait", "label": "Portrait" },
      { "value": "landscape", "label": "Landscape" }
    ] },
    { "type": "select", "id": "card_style", "label": "Card style", "default": "overlay", "options": [
      { "value": "overlay", "label": "Text overlay" },
      { "value": "below", "label": "Text below image" }
    ] },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFF8F5" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#151515" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        {
          "type": "select",
          "id": "builtin_image",
          "label": "Built-in recipient image",
          "default": "none",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "bestie", "label": "Bestie" },
            { "value": "partner", "label": "Partner" },
            { "value": "pet-lover", "label": "Pet Lover" },
            { "value": "kid-baby", "label": "Kid & Baby" },
            { "value": "mom", "label": "Mom" },
            { "value": "dad", "label": "Dad" },
            { "value": "grandparents", "label": "Grandparents" },
            { "value": "yourself", "label": "Yourself" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "For Her" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MC image link grid",
      "blocks": [
        { "type": "item", "settings": { "title": "For Her" } },
        { "type": "item", "settings": { "title": "For Him" } },
        { "type": "item", "settings": { "title": "For Couples" } },
        { "type": "item", "settings": { "title": "For Family" } }
      ]
    }
  ]
}
{% endschema %}