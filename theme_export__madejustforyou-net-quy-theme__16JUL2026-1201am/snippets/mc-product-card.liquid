{%- liquid
  assign card_product = product
  assign placeholder_links = placeholder_links | default: true
  assign show_rating = show_rating | default: true
  assign show_badge = show_badge | default: true
  assign show_wishlist = show_wishlist | default: true
  assign image_ratio = image_ratio | default: 'square'
  assign placeholder_index = placeholder_index | default: 1
  assign bestseller_label = bestseller_label | default: 'Bestseller'
  assign sale_label = sale_label | default: 'Sale'
  assign sold_out_label = sold_out_label | default: 'Sold out'
  assign wishlist_label = wishlist_label | default: 'Add to wishlist'
  assign rating_label = rating_label | default: 'out of 5 stars'
  assign product_url = '#'

  if card_product != blank
    assign product_url = card_product.url
  endif

  if card_product != blank
    assign featured_media = card_product.featured_media.preview_image
    assign secondary_media = card_product.media[1].preview_image
    assign compare_at_price = card_product.compare_at_price
    assign price = card_product.price
    assign on_sale = false
    if compare_at_price > price
      assign on_sale = true
    endif
    assign rating_value = card_product.metafields.reviews.rating.value.rating | default: card_product.metafields.reviews.rating.value
    assign rating_count = card_product.metafields.reviews.rating_count.value | default: card_product.metafields.reviews.rating_count
  endif
-%}

<article class="mc-product-card" data-mc-product-card>
  <div class="mc-product-card__media mc-product-card__media--{{ image_ratio }}">
    <a class="mc-product-card__media-link mc-focus-ring" href="{{ product_url }}" aria-label="{% if card_product != blank %}{{ card_product.title | escape }}{% else %}Sample product{% endif %}">
      {% if featured_media != blank %}
        {{ featured_media | image_url: width: 900 | image_tag: class: 'mc-product-card__image mc-product-card__image--primary', widths: '240, 360, 480, 640, 900', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: card_product.title }}
        {% if secondary_media != blank %}
          {{ secondary_media | image_url: width: 900 | image_tag: class: 'mc-product-card__image mc-product-card__image--secondary', widths: '240, 360, 480, 640, 900', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: card_product.title }}
        {% endif %}
      {% else %}
        {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'mc-product-card__placeholder' }}
      {% endif %}
    </a>

    {% if show_badge %}
      {% if card_product == blank %}
        <span class="mc-product-card__badge">{{ bestseller_label }}</span>
      {% elsif on_sale %}
        <span class="mc-product-card__badge">{{ sale_label }}</span>
      {% elsif card_product.available == false %}
        <span class="mc-product-card__badge mc-product-card__badge--muted">{{ sold_out_label }}</span>
      {% endif %}
    {% endif %}

    {% if show_wishlist %}
      <button class="mc-reset-button mc-product-card__wishlist mc-focus-ring" type="button" aria-label="{{ wishlist_label | escape }}" aria-pressed="false" data-mc-wishlist>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/></svg>
      </button>
    {% endif %}
  </div>

  <div class="mc-product-card__content">
    {% if show_rating %}
      {% if rating_value != blank %}
        <div class="mc-product-card__rating" aria-label="{{ rating_value }} {{ rating_label | escape }}">
          <span aria-hidden="true">★★★★★</span>
          {% if rating_count != blank %}<small>({{ rating_count }})</small>{% endif %}
        </div>
      {% elsif card_product == blank %}
        <div class="mc-product-card__rating" aria-label="5 {{ rating_label | escape }}"><span aria-hidden="true">★★★★★</span><small>(24)</small></div>
      {% endif %}
    {% endif %}

    <h3 class="mc-product-card__title">
      <a href="{{ product_url }}">{% if card_product != blank %}{{ card_product.title }}{% else %}Personalized keepsake gift for someone special{% endif %}</a>
    </h3>

    <div class="mc-product-card__price">
      {% if card_product != blank %}
        {% if on_sale %}
          <span class="mc-product-card__price-current">{{ price | money_with_currency }}</span>
          <s>{{ compare_at_price | money_with_currency }}</s>
        {% else %}
          <span class="mc-product-card__price-current">{{ price | money_with_currency }}</span>
        {% endif %}
      {% else %}
        <span class="mc-product-card__price-current">$24.99 USD</span>
        <s>$34.99 USD</s>
      {% endif %}
    </div>
  </div>
</article>
